<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Everything iroh does (QUIC to peers/relays, DNS/pkarr lookups) is
         covered by INTERNET; the reference app needs no other permissions. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.CroftCall"
        android:allowBackup="false">

        <!-- singleTask so a deep link while the app is open arrives via
             onNewIntent instead of relaunching and rebinding the endpoint. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link from the Croft Exchange page:
                 croftcall://call?endpoint=...&relay=...&handle=...&did=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="croftcall" android:host="call" />
            </intent-filter>

            <!-- Exchange invite links (contract §4): the app offers itself for
                 https://connect.croft.ing/redeem and runs ticket redemption.
                 NOT autoVerify — without assetlinks.json this appears in the
                 browser/app chooser rather than opening directly. Production
                 upgrade: add autoVerify once /.well-known/assetlinks.json on
                 connect.croft.ing carries the real release-signing SHA-256
                 (see docs/adr/0003); the filter itself stays the same. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="connect.croft.ing"
                      android:path="/redeem" />
            </intent-filter>

            <!-- atproto OAuth redirect (Phase 11 M3). The spec fixes the
                 custom scheme to the client_id hostname reversed:
                 ing.croft.connect:/oauth. The URI has no authority, so
                 Android can only match on scheme here; route() checks the
                 rest. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ing.croft.connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
